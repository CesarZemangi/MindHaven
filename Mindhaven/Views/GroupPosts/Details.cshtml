@model Mindhaven.Models.GroupPost

@{
    ViewBag.Title = "Post Details";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<h2>@Model.SupportGroup.Name</h2>

<p>
    <strong>Posted by:</strong> @Model.User.FullName
</p>

<p>
    <strong>Posted on:</strong> @Model.PostedAt
</p>

<hr />

<div style="font-size:16px; line-height:1.6;">
    @Model.PostContent
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.PostID }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}

else
{
    @Html.ActionLink("Back to List", "Index")
}
