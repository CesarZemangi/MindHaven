@model Mindhaven.Models.UserAchievement

@{
    ViewBag.Title = "Achievement";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>Achievement</h2>

<p>
    <strong>User:</strong> @Model.User.FullName
</p>

<p>
    <strong>Date earned:</strong> @Model.DateEarned
</p>

<hr />

<div style="font-size:20px;">
    <strong>Badge:</strong> @Model.BadgeType
</div>

<p>
    <strong>Progress:</strong> @Model.Progress
</p>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.AchievementId }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}
