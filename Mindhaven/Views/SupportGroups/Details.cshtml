@model Mindhaven.Models.SupportGroup

@{
    ViewBag.Title = Model.Name;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.Name</h2>

<p>
    <strong>Created on:</strong> @Model.CreatedAt
</p>

<hr />

<div style="font-size:16px; line-height:1.6;">
    @Model.Description
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.GroupID }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}
