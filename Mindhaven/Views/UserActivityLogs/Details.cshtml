@model Mindhaven.Models.UserActivityLog

@{
    ViewBag.Title = "Activity Log";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.SelfCareActivity.Title</h2>

<p>
    <strong>User:</strong> @Model.User.FullName
</p>

<p>
    <strong>Completed on:</strong> @Model.CompletedAt
</p>

<hr />

<p>
    <strong>Notes</strong>
</p>

<div style="font-size:16px; line-height:1.6;">
    @Model.Notes
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.LogId }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}
