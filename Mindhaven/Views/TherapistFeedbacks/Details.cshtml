@model Mindhaven.Models.TherapistFeedback

@{
    ViewBag.Title = "Therapist Feedback";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>Therapist Feedback</h2>

<p>
    <strong>Given by:</strong> @Model.User.FullName
</p>

<p>
    <strong>Date:</strong> @Model.FeedbackDate
</p>

<hr />

<p>
    <strong>Feedback Notes</strong>
</p>

<div style="font-size:16px; line-height:1.6;">
    @Model.Notes
</div>

<hr />

<p>
    <strong>Related Submission</strong>
</p>

<div style="font-size:16px; line-height:1.6;">
    @Model.HomeworkSubmission.TextResponse
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.FeedbackId }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}
