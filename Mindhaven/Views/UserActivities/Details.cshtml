@model Mindhaven.Models.UserActivity

@{
    ViewBag.Title = "User Activity";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>User Activity</h2>

<p>
    <strong>User:</strong> @Model.User.FullName
</p>

<p>
    <strong>Date:</strong> @Model.ActivityDate
</p>

<hr />

<div style="font-size:16px; line-height:1.6;">
    @Model.ActivityDescription
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.ActivityID }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}

