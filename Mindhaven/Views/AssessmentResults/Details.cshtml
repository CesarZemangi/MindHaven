@model Mindhaven.Models.AssessmentResult

@{
    ViewBag.Title = "Assessment Result";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.Assessment.Title</h2>

<p>
    <strong>Participant:</strong> @Model.User.FullName
</p>

<p>
    <strong>Taken on:</strong> @Model.TakenAt
</p>

<hr />

<div style="font-size:20px;">
    <strong>Score:</strong> @Model.Score
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.ResultID }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}
