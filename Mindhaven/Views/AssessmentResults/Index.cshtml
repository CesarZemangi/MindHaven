@model IEnumerable<Mindhaven.ViewModels.AssessmentIndexViewModel>

@{
    ViewBag.Title = "Available Assessments";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<h2>Available Assessments</h2>

<table class="table table-bordered table-striped">
    <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Status / Score</th>
        <th>Actions</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>
                @if (item.Score.HasValue)
                {
                    <span>Score: @item.Score</span><br />
                    <span>Taken: @item.TakenAt?.ToString("g")</span>
                }
                else
                {
                    <span>Not Taken</span>
                }
            </td>
            <td>
                @if (isAdmin)
                {
                    <a href="@Url.Action("Edit", "Assessments", new { id = item.AssessmentID })" class="btn btn-sm btn-primary">Edit</a>
                    <a href="@Url.Action("Details", "Assessments", new { id = item.AssessmentID })" class="btn btn-sm btn-info">Details</a>
                    <a href="@Url.Action("Delete", "Assessments", new { id = item.AssessmentID })" class="btn btn-sm btn-danger">Delete</a>
                }
                else
                {
                    if (!item.Score.HasValue)
                    {
                        <a href="@Url.Action("TakeAssessment", "AssessmentResults", new { assessmentId = item.AssessmentID })" class="btn btn-sm btn-success">
                            Take Assessment
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "AssessmentResults")" class="btn btn-sm btn-warning">
                            View My Result
                        </a>
                    }
                }
            </td>
        </tr>
    }
</table>
