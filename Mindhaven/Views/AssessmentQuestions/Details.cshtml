@model Mindhaven.Models.AssessmentQuestion

@{
    ViewBag.Title = "Question Details";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h3>@Model.Assessment.Title</h3>

<hr />

<div style="font-size:18px; line-height:1.6;">
    @Model.QuestionText
</div>

<hr />
@if (isAdmin) {
    <span>

    @Html.ActionLink("Edit", "Edit", new { id = Model.QuestionID }) |
    @Html.ActionLink("Back to List", "Index")
        </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}