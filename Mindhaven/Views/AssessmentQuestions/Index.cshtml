@model IEnumerable<dynamic>

@{
    ViewBag.Title = "Available Assessments";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<h2>Available Assessments</h2>

<table class="table">
    <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Status / Score</th>
        <th>Action</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.Description</td>
            <td>
                @if (item.UserResult != null)
                {
                    <span>Score: @item.UserResult.Score</span><br />
                    <span>Taken: @item.UserResult.TakenAt.ToString("g")</span>
                }
                else
                {
                    <span>Not Taken</span>
                }
            </td>
            <td>
                @if (isAdmin)
                {
                    <a href="~/Assessments/Edit/@item.AssessmentID" class="btn btn-sm btn-primary">Edit</a>
                    <a href="~/Assessments/Details/@item.AssessmentID" class="btn btn-sm btn-info">Details</a>
                    <a href="~/Assessments/Delete/@item.AssessmentID" class="btn btn-sm btn-danger">Delete</a>
                }
                else
                {
                    if (item.UserResult == null)
                    {
                        <a href="~/AssessmentResults/TakeAssessment?assessmentId=@item.AssessmentID" class="btn btn-sm btn-success">
                            Take Assessment
                        </a>
                    }
                    else
                    {
                        <a href="~/AssessmentResults/Index" class="btn btn-sm btn-warning">
                            View My Result
                        </a>
                    }
                }
            </td>
        </tr>
    }
</table>
