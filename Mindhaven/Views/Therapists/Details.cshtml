@model Mindhaven.Models.Therapist

@{
    ViewBag.Title = Model.User.FullName;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.User.FullName</h2>

<p>
    <strong>Specialization:</strong> @Model.Specialization
</p>

<p>
    <strong>Available slots:</strong> @Model.AvailableSlots
</p>

<hr />

<p>
    <strong>About</strong>
</p>

<div style="font-size:16px; line-height:1.6;">
    @Model.Bio
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.TherapistID }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}
