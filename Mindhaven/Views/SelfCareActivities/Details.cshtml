@model Mindhaven.Models.SelfCareActivity

@{
    ViewBag.Title = Model.Title;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.Title</h2>

<p>
    <strong>Type:</strong> @Model.ActivityType
</p>

<p>
    <strong>Status:</strong> @(Model.IsActive ? "Active" : "Inactive")
</p>

<hr />

<div style="font-size:16px; line-height:1.6;">
    @Model.Description
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.ActivityId }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}

else
{
    @Html.ActionLink("Back to List", "Index")
}
