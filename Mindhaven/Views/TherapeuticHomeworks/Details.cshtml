@model Mindhaven.Models.TherapeuticHomework

@{
    ViewBag.Title = Model.Title;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.Title</h2>

<p>
    <strong>Status:</strong> @Model.Status
</p>

<p>
    <strong>Assigned on:</strong> @Model.AssignedDate
</p>

<p>
    <strong>Due date:</strong> @Model.DueDate
</p>

<p>
    <strong>Assigned by:</strong> @Model.User1.FullName
</p>

<p>
    <strong>Assigned to:</strong> @Model.User.FullName
</p>

<hr />

<div style="font-size:16px; line-height:1.6;">
    @Model.Description
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.HomeworkId }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}
