@model Mindhaven.Models.Resource1

@{
    ViewBag.Title = Model.Title;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.Title</h2>

<p>
    <strong>Type:</strong> @Model.MediaType
</p>

<hr />

<div style="font-size:16px; line-height:1.6;">
    @Model.Content
</div>

<hr />

@if (!string.IsNullOrEmpty(Model.Link))
{
    <p>
        <a href="@Model.Link" target="_blank">Open Resource</a>
    </p>
}

<hr />

@if (isAdmin)
{
    <span>
        }
        @Html.ActionLink("Edit", "Edit", new { id = Model.ResourceID }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}

