@model Mindhaven.Models.Article

@{
    ViewBag.Title = Model.Title;
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;

}

<h2>@Model.Title</h2>

<p>
    <strong>By:</strong> @Model.User.FullName
</p>

<p>
    <strong>Published on:</strong> @Model.PublishedDate
</p>

<p>
    <strong>Category:</strong> @Model.Category
</p>

<hr />

@if (!string.IsNullOrEmpty(Model.ImageUrl))
{
    <img src="@Model.ImageUrl" alt="Article image" style="max-width:100%; height:auto;" />
    <hr />
}

<p>
    <strong>Summary</strong>
</p>

<p>
    @Model.Summary
</p>

<hr />

<div style="font-size:16px; line-height:1.6;">
    @Model.Content
</div>

<hr />

@if (isAdmin)
{
    <span>
        @Html.ActionLink("Edit", "Edit", new { id = Model.ArticleId }) |
        @Html.ActionLink("Back to List", "Index")
    </span>
}
else
{
    @Html.ActionLink("Back to List", "Index")
}

