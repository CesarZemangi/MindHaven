@model Mindhaven.Models.Article

@{
    var wordCount = string.IsNullOrWhiteSpace(Model.Content)
        ? 0
        : Model.Content.Split(new[] { ' ', '\n', '\r', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;

    var readingTime = Math.Max(1, wordCount / 200);
}

<div class="read-wrapper">
    <div class="article-card">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="article-image">
                <img src="@Model.ImageUrl" alt="@Model.Title" />
            </div>
        }

        <div class="article-body">
            <div class="article-top">
                <span class="article-category">@Model.Category</span>

                <span class="reading-time">
                    @readingTime min read
                </span>
            </div>

            <h1 class="article-title">@Model.Title</h1>

            @if (Model.PublishedDate.HasValue)
            {
                <p class="article-meta">
                    Published on @Model.PublishedDate.Value.ToString("MMMM dd, yyyy")
                </p>
            }

            @if (Model.Tags != null && Model.Tags.Any())
            {
                <div class="tag-container">
                    @foreach (var tag in Model.Tags)
                    {
                        <span class="tag-chip">@tag.Name</span>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Summary))
            {
                <div class="article-summary">
                    <p>@Model.Summary</p>
                </div>
            }

            <div class="article-content">
                @foreach (var paragraph in Model.Content
                    .Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@paragraph</p>
                }
            </div>

            <div class="article-footer">
                <a href="@Url.Action("Index", "Home")" class="back-btn">
                    Back to Home
                </a>
            </div>
        </div>
    </div>
</div>

<style>
:root {
    --bg: #f3f4f6;
    --card: #ffffff;
    --text-main: #111827;
    --text-muted: #6b7280;
    --accent: #111827;
    --chip-bg: #e5e7eb;
}

body.dark-mode {
    --bg: #0f172a;
    --card: #020617;
    --text-main: #e5e7eb;
    --text-muted: #94a3b8;
    --accent: #e5e7eb;
    --chip-bg: #1e293b;
}

.read-wrapper {
    display: flex;
    justify-content: center;
    padding: 24px;
    background: var(--bg);
    min-height: 100vh;
}

.article-card {
    max-width: 820px;
    width: 100%;
    background: var(--card);
    border-radius: 14px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    overflow: hidden;
    animation: fadeUp 0.5s ease;
}

.article-image img {
    width: 100%;
    display: block;
}

.article-body {
    padding: 28px;
    color: var(--text-main);
}

.article-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.article-category {
    font-size: 14px;
    color: var(--text-muted);
}

.reading-time {
    font-size: 14px;
    color: var(--text-muted);
}

.article-title {
    font-size: 32px;
    line-height: 1.3;
    margin-bottom: 12px;
}

.article-meta {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 18px;
}

.tag-container {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
}

.tag-chip {
    padding: 6px 12px;
    font-size: 13px;
    background: var(--chip-bg);
    border-radius: 999px;
}

.article-summary {
    background: var(--chip-bg);
    padding: 16px;
    border-radius: 10px;
    margin-bottom: 24px;
}

.article-content p {
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 18px;
    color: var(--text-main);
}

.article-footer {
    margin-top: 32px;
}

.back-btn {
    display: inline-block;
    padding: 10px 18px;
    background: var(--accent);
    color: var(--card);
    text-decoration: none;
    border-radius: 8px;
    font-size: 14px;
}

@@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(16px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@@media (max-width: 640px) {
    .article-title {
        font-size: 24px;
    }

    .article-body {
        padding: 20px;
    }

    .article-content p {
        font-size: 16px;
    }
}
</style>
